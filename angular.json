{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "manager": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html",
            "tsConfig": "tsconfig.json", "outputPath": "dist/manager",
            "baseHref": "./", "styles": ["src/styles.css"],
            "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
            "budgets": [{ "type": "initial", "maximumWarning": "400kB", "maximumError": "500kB" }]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "manager:build" } }
      }
    }
  }
}
