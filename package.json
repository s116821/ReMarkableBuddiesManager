{
  "name": "remarkable-buddies-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Angular browser and Electron companion foundation",
  "license": "GPL-3.0-only",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "node scripts/version.mjs && ng serve --host 127.0.0.1",
    "build": "node scripts/version.mjs && ng build && node scripts/notices.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:hosts": "node tests/hosts.mjs",
    "test:release": "python -m unittest discover -s release -v",
    "check": "npm run lint && npm test && npm run test:styles && npm run build && npm run test:hosts",
    "desktop": "npm run build && electron .",
    "package": "node scripts/package.mjs",
    "test:package": "node tests/hosts.mjs --packaged",
    "wired:browser": "node scripts/wired-browser.mjs",
    "test:wired-hosts": "node tests/wired-hosts.mjs",
    "build:development": "node scripts/version.mjs && ng build --configuration development --output-path test-results/development",
    "test:styles": "npm run build:development && node tests/hosts.mjs --development"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.0.0",
    "electron": "44.4.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
